# Copy to .env (git-ignored) or export in your shell. Never commit real keys.

# TypeSafe hosted Jev (https://api.typesafe.ai)
TYPESAFE_API_KEY=

# LangSmith LLM Gateway (TypeSafe-compatible decision models, e.g. semif-qwen3.5-4b)
LANGSMITH_API_KEY=

# OpenAI Decisions API (gpt-6-luna)
OPENAI_API_KEY=

# Local llama-server used by the logprob backend
S1EVAL_LLAMA_URL=http://127.0.0.1:8081
