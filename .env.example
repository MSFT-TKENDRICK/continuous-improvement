# Copy to .env (git-ignored) or export in your shell. Never commit real keys.
# ASSERT and the agent both route models through LiteLLM, so any LiteLLM
# provider works; model names live in the eval configs (default_model.name)
# and ORDER_AGENT_MODEL.

# Local OpenAI-compatible server (llama-server --alias local), model "openai/local"
OPENAI_API_BASE=http://127.0.0.1:8081/v1
OPENAI_API_KEY=dummy

# Model the order-support agent (the eval target) uses; optional temperature
ORDER_AGENT_MODEL=openai/local
# ORDER_AGENT_TEMPERATURE=0
# Per-call agent timeout in seconds; defaults to ORDER_EVALS_MODEL_TIMEOUT_S
# (or --model-timeout), else 600 s
# ORDER_AGENT_TIMEOUT_S=1800

# Per-call timeout for every ASSERT model call (judge, tester, test-set generation, ...)
# for slow local models; ASSERT's built-in judge/tester timeout is 300 s
ORDER_EVALS_MODEL_TIMEOUT_S=1800

# Max concurrent test-set generation calls (--test-set-concurrency); defaults to
# --concurrency when given, else ASSERT runs up to 8 per kind, both kinds at once
# ORDER_EVALS_TEST_SET_CONCURRENCY=1

# Azure OpenAI instead (e.g. --override default_model.name=azure/gpt-5.4-mini)
# AZURE_API_BASE=https://<resource>.openai.azure.com/
# AZURE_API_VERSION=2025-04-01-preview
# AZURE_API_KEY=            # or leave unset to use Entra ID (az login)